# Optional local API settings. The Node server reads process environment values;
# it does not load this file automatically.
PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
NODE_ENV=development

# Used only by the optional Firebase Functions seed script. Project ID is not a credential.
CAMPUS_GHOST_FIREBASE_PROJECT_ID=your-firebase-project-id
